generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  files       ProjectFile[]

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

enum FileNodeType {
  FILE
  FOLDER
}

model ProjectFile {
  id        String       @id @default(cuid())
  name      String
  type      FileNodeType
  content   String?      @db.Text
  projectId String
  parentId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  revision Int @default(1)

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   ProjectFile?  @relation("FileTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ProjectFile[] @relation("FileTree")

  @@index([projectId])
  @@index([parentId])
}
